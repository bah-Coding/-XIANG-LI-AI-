<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hmdp.mapper.UserMapper">
    <select id="selectByPhone" resultType="com.hmdp.entity.User">
        select * from tb_user where phone = #{phone}
    </select>
    
    <!-- useGeneratedKeys + keyProperty: 插入后把自增主键回填到 User.id，
         否则登录时写入 Redis 的 id 为空，个人主页 /user/info/undefined 会 500 -->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into tb_user (phone, nick_name, create_time, update_time) values
        (#{phone}, #{nickName}, #{createTime}, #{updateTime})
    </insert>
</mapper>
