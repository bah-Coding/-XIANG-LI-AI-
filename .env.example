# Copy this file to local.env.ps1 and fill in your own values.
# local.env.ps1 is gitignored, so real credentials never reach the repository.
# Keep this file ASCII-only: Windows PowerShell 5.1 reads UTF-8 without BOM as
# ANSI, and non-ASCII comments may swallow the next line.

# --- MySQL ---
$env:DB_USERNAME = 'root'
$env:DB_PASSWORD = '<your-db-password>'
# Optional full JDBC url (default: localhost:3306/hmdp):
# $env:DB_URL = 'jdbc:mysql://localhost:3306/hmdp?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8'

# --- Redis ---
# Leave REDIS_HOST unset to use localhost; set it for a remote/VM instance.
# $env:REDIS_HOST = '<redis-host>'
# $env:REDIS_PORT = '6379'
# $env:REDIS_PASSWORD = '<redis-password>'

# --- RabbitMQ (order timeout cancel) ---
# $env:RABBITMQ_HOST = '<rabbitmq-host>'
# $env:RABBITMQ_PORT = '5672'
# $env:RABBITMQ_USERNAME = '<rabbitmq-user>'
# $env:RABBITMQ_PASSWORD = '<rabbitmq-password>'
# Set to false when no broker is available (disables listener + publishing)
# $env:RABBITMQ_ENABLED = 'false'
# Order timeout in ms, default 900000 (15 minutes)
# $env:ORDER_TIMEOUT_MS = '900000'

# --- Image upload dir (point to the Nginx static imgs folder) ---
$env:IMAGE_UPLOAD_DIR = '<project>/AI-dianping-frontend/html/hmdp/imgs/'

# --- Log dir (default: <working dir>/logs/backend) ---
# logback only reads system properties, so start-all.ps1 converts this into -DLOG_PATH.
$env:LOG_PATH = '<project>/logs/backend'

# --- Optional: LLM API key (without it AI skills use local fallback) ---
# $env:API_KEY = 'sk-xxxxxxxx'

# --- Security: API key required by /mcp and /actuator (empty = auth disabled, dev only) ---
$env:MCP_API_KEY = '<change-me>'
